// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // The container runs on Alpine (musl) with OpenSSL 3.x. Prisma's autodetect
  // guesses openssl-1.1.x there and emits an engine that cannot load, so the
  // target is pinned. "native" keeps local dev working.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled (Supabase transaction pooler, :6543) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Unpooled (session pooler, :5432) — migrations cannot run over the
  // transaction pooler, so the CLI needs its own connection.
  directUrl = env("DIRECT_URL")
}

