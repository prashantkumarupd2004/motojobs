model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String
  phone           String?
  role            String    @default("CANDIDATE")
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  profileImage    String?
  /// Set when an admin suspends the account; `isActive` stays the fast check.
  suspendedAt     DateTime?
  suspendedReason String?
  /// Last successful sign-in, for the admin's login-activity view.
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidate          Candidate?
  recruiter          Recruiter?
  supportTickets     SupportTicket[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  notifications      Notification[]
  messages           Message[]
  blogPosts          BlogPost[]
  activityLogs       ActivityLog[]
  loginHistory       LoginHistory[]

  @@index([role, createdAt])
  @@map("users")
}

/// Email OTP codes. `codeHash` is a SHA-256 digest — never store the raw code.
model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  purpose    String    @default("SIGNUP") // SIGNUP | LOGIN_VERIFY | EMAIL_CHANGE
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// Password reset OTP codes. `codeHash` is a SHA-256 digest — never store the raw code.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Candidate {
  id             String  @id @default(cuid())
  userId         String  @unique
  headline       String?
  summary        String?
  location       String?
  experience     Int? // years
  currentSalary  Float?
  expectedSalary Float?
  noticePeriod   Int? // days
  profileScore   Int     @default(0)
  isOpenToWork   Boolean @default(true)
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?

  /// FRESHER | AUTOMOBILE | NON_AUTOMOBILE — drives which fields below apply.
  candidateType     String?
  isProfileComplete Boolean @default(false)
  /// Furthest onboarding step reached, so a dropped session can resume.
  profileStep       Int     @default(0)

  dateOfBirth        DateTime?
  gender             String?
  interestedRole     String?
  currentCity        String?
  currentState       String?
  /// JSON string array. SQLite has no native list type; parse before use.
  preferredLocations String?
  qualification      String?

  /// Uppercase PAN (ABCDE1234F). Aadhaar is deliberately not collected.
  panNumber  String?
  /// Private S3 key path served through /api/files.
  panCardUrl String?

  /// JSON string array of JOB_CATEGORIES ids.
  jobCategories String?
  /// JSON string array of JOB_TITLES the candidate selected in onboarding.
  jobTitles     String?

  // Fresher branch
  passingYear    Int?
  college        String?
  internship     String?
  certifications String?

  // Both experienced branches
  totalExperience    String?
  currentCompany     String?
  currentDesignation String?
  noticePeriodBand   String?
  /// JSON string array of OEM_BRANDS — AUTOMOBILE branch only.
  brandExperience    String?
  /// Previous sector — NON_AUTOMOBILE branch only.
  industry           String?

  resumeUrl       String?
  resumeName      String?
  drivingLicense  Boolean   @default(false)
  ownVehicle      Boolean   @default(false)
  /// JSON string array of LANGUAGES.
  languages       String?
  referralCode    String?
  acceptedTermsAt DateTime?

  // Job preferences (onboarding step 7)
  preferredRole  String?
  preferredBrand String?
  preferredState String?
  preferredCity  String?
  /// One of JOB_TYPES.
  employmentType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes        Resume[]
  applications   Application[]
  savedJobs      SavedJob[]
  skills         CandidateSkill[]
  ratings        CandidateRating[]
  verification   CandidateVerification?
  education      Education[]
  workExperience WorkExperience[]
  profileViews   ProfileView[]
  savedBy        SavedCandidate[]

  @@map("candidates")
}

/// One row per recruiter viewing a candidate, so the dashboard count is real.
model ProfileView {
  id          String   @id @default(cuid())
  candidateId String
  recruiterId String?
  viewedAt    DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, viewedAt])
  @@map("profile_views")
}

model Education {
  id          String   @id @default(cuid())
  candidateId String
  degree      String
  institution String
  field       String?
  startYear   Int
  endYear     Int?
  grade       String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("education")
}

model WorkExperience {
  id          String    @id @default(cuid())
  candidateId String
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("work_experience")
}

model Recruiter {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyId   String?
  designation String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?               @relation(fields: [companyId], references: [id])
  jobs         Job[]
  verification RecruiterVerification?

  @@map("recruiters")
}

model Company {
  id                String   @id @default(cuid())
  name              String
  /// URL-safe identifier used by /company/[slug].
  slug              String?  @unique
  logo              String?
  website           String?
  industry          String?
  size              String?
  description       String?
  headquarters      String?
  foundedYear       Int?
  linkedinUrl       String?
  /// 15-character Indian GSTIN, uppercase.
  gstNumber         String?
  /// Company PAN (ABCDE1234F), uppercase. Optional at onboarding.
  panNumber         String?
  addressLine       String?
  city              String?
  state             String?
  pincode           String?
  /// Optional Google Maps link to the premises, shown on the public page.
  mapsUrl           String?
  phone             String?
  /// Public recruitment inbox — distinct from the recruiter's login email.
  email             String?
  isProfileComplete Boolean  @default(false)
  isVerified        Boolean  @default(false)

  /// JSON string array of HIRING_CATEGORIES the employer recruits for.
  hiringCategories String?
  /// Daily | Weekly | Monthly | Occasionally
  hiringFrequency  String?
  hrName           String?
  hrPhone          String?
  /// Furthest onboarding step reached, so a dropped session can resume.
  onboardingStep     Int @default(0)
  /// Mirrors EMPLOYER_STEP_COMPLETION so the dashboard and wizard agree.
  profileCompletion  Int @default(0)

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiters      Recruiter[]
  jobs            Job[]
  documents       CompanyDocument[]
  subscriptions   Subscription[]
  savedCandidates SavedCandidate[]
  interviews      Interview[]

  @@map("companies")
}

model CompanyDocument {
  id         String    @id @default(cuid())
  companyId  String
  /// GST_CERTIFICATE | INCORPORATION | PAN | ADDRESS_PROOF | OTHER
  type       String
  fileUrl    String
  fileName   String?
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  adminNotes String?
  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_documents")
}

model Job {
  id               String    @id @default(cuid())
  recruiterId      String
  companyId        String?
  title            String
  description      String
  requirements     String?
  responsibilities String?
  skills           String    @default("[]")
  category         String? // automotive category id, see src/lib/automotive.ts
  jobType          String // Full-time, Part-time, Contract, Apprenticeship, Internship
  workMode         String // Onsite, Hybrid, Remote
  location         String?
  /// State and city are stored separately so the employer picks them from the
  /// same lists candidates do; `location` stays the joined display string.
  state            String?
  city             String?
  minSalary        Float?
  maxSalary        Float?
  currency         String    @default("INR")
  experience       String?
  education        String?
  /// JSON string array of BENEFITS offered with the role.
  benefits         String    @default("[]")
  /// Immediate | Within 15 days | Within 30 days | Within 60 days | Flexible
  joiningTimeline  String?
  /// DRAFT | PENDING | APPROVED | REJECTED | CLOSED
  status           String    @default("PENDING")
  openings         Int       @default(1)
  deadline         DateTime?
  views            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recruiter    Recruiter     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id])
  applications Application[]
  savedJobs    SavedJob[]
  interviews   Interview[]

  @@index([recruiterId, status])
  @@map("jobs")
}

/// A candidate an employer bookmarked from search, so they can come back to a
/// profile without an application existing yet. Scoped to the company rather
/// than the recruiter so a colleague sees the same shortlist.
model SavedCandidate {
  id          String   @id @default(cuid())
  companyId   String
  candidateId String
  /// Free-text note the recruiter attached when saving.
  notes       String?
  savedAt     DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([companyId, candidateId])
  @@index([companyId, savedAt])
  @@map("saved_candidates")
}

/// A scheduled interview. Anchored to an application so an employer cannot
/// invite a candidate who never applied, matching the Conversation rule.
model Interview {
  id            String   @id @default(cuid())
  applicationId String
  companyId     String
  jobId         String
  scheduledAt   DateTime
  durationMins  Int      @default(30)
  /// IN_PERSON | PHONE | VIDEO
  mode          String   @default("IN_PERSON")
  /// Address for IN_PERSON, meeting link for VIDEO, number for PHONE.
  venue         String?
  notes         String?
  /// SCHEDULED | COMPLETED | CANCELLED
  status        String   @default("SCHEDULED")
  outcome       String?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, status, scheduledAt])
  @@index([applicationId])
  @@map("interviews")
}

model Application {
  id             String   @id @default(cuid())
  jobId          String
  candidateId    String
  resumeId       String?
  coverLetter    String?
  status         String   @default("APPLIED")
  stage          String   @default("Applied")
  aiScore        Float?
  aiNotes        String?
  recruiterNotes String?
  appliedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resume       Resume?       @relation(fields: [resumeId], references: [id])
  conversation Conversation?
  interviews   Interview[]

  @@unique([jobId, candidateId])
  @@map("applications")
}

model Resume {
  id            String   @id @default(cuid())
  candidateId   String
  title         String   @default("My Resume")
  fileUrl       String?
  fileType      String?
  isAIGenerated Boolean  @default(false)
  content       String? // AI-generated structured content
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("resumes")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  candidates CandidateSkill[]

  @@map("skills")
}

model CandidateSkill {
  id          String  @id @default(cuid())
  candidateId String
  skillId     String
  level       String? // Beginner, Intermediate, Expert
  yearsExp    Int?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}




model SavedJob {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  savedAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@map("saved_jobs")
}

model CandidateRating {
  id          String   @id @default(cuid())
  candidateId String
  recruiterId String
  jobId       String?
  rating      Int // 1-5
  notes       String?
  tags        String   @default("[]")
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_ratings")
}

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  /// CONTACT | FEEDBACK | BUG | OTHER — drives the admin support tabs.
  category    String?
  adminNotes  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("support_tickets")
}

model Payment {
  id             String    @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String    @default("INR")
  plan           String // basic, professional, enterprise
  status         String    @default("PENDING")
  transactionId  String?
  paymentMethod  String?
  description    String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("payments")
}

model RecruiterVerification {
  id            String    @id @default(cuid())
  recruiterId   String    @unique
  companyRegDoc String?
  idProof       String?
  status        String    @default("PENDING")
  adminNotes    String?
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("recruiter_verification")
}

model CandidateVerification {
  id          String    @id @default(cuid())
  candidateId String    @unique
  idProof     String?
  status      String    @default("PENDING")
  adminNotes  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_verification")
}

/// In-app notifications. Delivery to email/WhatsApp is a separate concern —
/// this table records what the user should see, and `channels` tracks where a
/// copy was already sent so a retry cannot double-send.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// APPLICATION_STATUS | NEW_APPLICANT | JOB_APPROVED | JOB_REJECTED |
  /// DOCUMENT_REVIEWED | SUBSCRIPTION | MESSAGE | INTERVIEW | SYSTEM
  type      String
  title     String
  body      String?
  /// Where clicking the notification should land the user.
  link      String?
  /// JSON array of delivered channels, e.g. ["EMAIL"].
  channels  String    @default("[]")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// A recruiter/candidate conversation, always anchored to an application so
/// neither side can cold-message the other.
model Conversation {
  id            String   @id @default(cuid())
  applicationId String   @unique
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  /// JSON array of {url, name} objects.
  attachments    String    @default("[]")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Plan catalogue. Prices are stored in paise to avoid float rounding on money.
model Plan {
  id              String   @id @default(cuid())
  /// STARTER | GROWTH | ENTERPRISE
  code            String   @unique
  name            String
  description     String?
  pricePaise      Int      @default(0)
  /// MONTHLY | YEARLY | LIFETIME
  interval        String   @default("MONTHLY")
  jobPostLimit    Int?
  resumeViewLimit Int?
  /// JSON array of feature strings shown on /pricing.
  features        String   @default("[]")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

/// A company's plan. Usage counters live here rather than being derived from
/// job counts, so a plan change or renewal resets the quota cleanly.
model Subscription {
  id               String    @id @default(cuid())
  companyId        String
  planId           String
  /// ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status           String    @default("ACTIVE")
  jobPostsUsed     Int       @default(0)
  resumeViewsUsed  Int       @default(0)
  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([companyId, status])
  @@map("subscriptions")
}

/// Author-managed blog posts. `src/lib/blog.ts` still serves the public pages;
/// this table backs the admin editor and takes over once posts exist here.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  /// Markdown-ish body: `## ` lines are headings, blank-line separated.
  body        String
  category    String?
  /// JSON string array.
  tags        String    @default("[]")
  coverImage  String?
  authorId    String?
  /// Byline shown to readers, which need not be a user account.
  authorName  String?
  /// Falls back to `title` / `excerpt` when unset.
  seoTitle       String?
  seoDescription String?
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  readMinutes Int       @default(5)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blogs")
}

/// Audit trail for privileged actions. Append-only: rows are never updated, so
/// a reviewer can always reconstruct who changed what.
model ActivityLog {
  id         String   @id @default(cuid())
  /// Null for anonymous or system-initiated actions.
  actorId    String?
  /// e.g. DOCUMENT_APPROVED, JOB_REJECTED, USER_SUSPENDED
  action     String
  /// Table name the action targeted, e.g. "companies".
  entityType String?
  entityId   String?
  /// JSON blob of the relevant before/after fields.
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

/// Named role definitions backing the permission matrix. `User.role` stays the
/// fast path for the three built-in roles; this table exists so an admin can be
/// granted a narrower set later without a migration.
model Role {
  id          String   @id @default(cuid())
  /// CANDIDATE | RECRUITER | ADMIN | custom slug
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  /// resource:action, e.g. "job:approve"
  key       String   @unique
  label     String
  /// Grouping for the admin UI, e.g. "Jobs".
  category  String?
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------
// Admin-managed taxonomy
//
// The vocabulary in src/lib/automotive.ts is compiled into the bundle and
// imported by prisma/seed.ts, so it cannot be edited at runtime. These tables
// let the admin add a category or city without a deploy. The constants remain
// the seed source and the fallback, so a wiped table degrades to the built-in
// list rather than an empty dropdown.
// ------------------------------------------------------------------

/// One table for every flat list the admin curates, discriminated by `kind`.
/// Four near-identical tables would need four sets of routes and screens.
model Taxonomy {
  id String @id @default(cuid())
  /// JOB_CATEGORY | INDUSTRY | EXPERIENCE_LEVEL | EMPLOYMENT_TYPE |
  /// SKILL | QUALIFICATION
  kind      String
  /// Stable machine value persisted on jobs and profiles. Renaming `label` is
  /// safe; changing `value` orphans existing rows, so the UI keeps it fixed.
  value     String
  label     String
  /// Groups skills (Technical, EV, Sales…) and orders category cards.
  group     String?
  blurb     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, isActive, sortOrder])
  @@map("taxonomies")
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@map("states")
}

model City {
  id        String   @id @default(cuid())
  stateId   String
  name      String
  /// Marks the automotive hubs the homepage promotes.
  isHub     Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, name])
  @@index([stateId, isActive])
  @@map("cities")
}

// ------------------------------------------------------------------
// CMS, settings and operational logs
// ------------------------------------------------------------------

/// Editable copy for the marketing pages. `blocks` holds the page-specific
/// shape (hero fields, FAQ entries, footer columns) as JSON, so a new section
/// does not need a migration.
model CmsPage {
  id String @id @default(cuid())
  /// HOME | ABOUT | CONTACT | PRIVACY | TERMS | FAQ | FOOTER
  key             String    @unique
  title           String
  /// JSON object. Shape depends on `key` — see src/lib/cms.ts.
  blocks          String    @default("{}")
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean   @default(true)
  updatedById     String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("cms_pages")
}

/// Flat key/value store for website settings. Kept as strings so the admin can
/// add a setting without a migration; `group` drives the settings page tabs.
model SiteSetting {
  id String @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  /// BRANDING | CONTACT | SOCIAL | SEO | ANALYTICS | EMAIL
  group       String   @default("BRANDING")
  label       String
  /// TEXT | TEXTAREA | URL | EMAIL | IMAGE | BOOLEAN
  inputType   String   @default("TEXT")
  hint        String?
  /// True for credentials (SMTP password, API keys): the value is never sent to
  /// the browser, only whether it is set.
  isSecret    Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
  @@map("site_settings")
}

/// Transactional email copy. `src/lib/email.ts` keeps its hard-coded defaults;
/// a row here overrides them, so a broken edit cannot stop signup mail.
model EmailTemplate {
  id String @id @default(cuid())
  /// WELCOME | OTP | INTERVIEW | PASSWORD_RESET | CONTACT
  key       String   @unique
  name      String
  subject   String
  /// Body with {{placeholder}} tokens, listed in `variables`.
  bodyHtml  String
  bodyText  String
  /// JSON array of the tokens this template accepts.
  variables String   @default("[]")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("email_templates")
}

/// A broadcast the admin sends to a segment. Rows in `notifications` are
/// created per recipient when this is sent, so delivery is auditable.
model Announcement {
  id String @id @default(cuid())
  title    String
  body     String
  /// ALL | CANDIDATES | EMPLOYERS
  audience String    @default("ALL")
  /// IN_APP | EMAIL | BOTH
  channel  String    @default("IN_APP")
  link     String?
  /// DRAFT | SENT
  status   String    @default("DRAFT")
  /// How many recipients it reached, so a resend is obvious.
  sentCount Int      @default(0)
  sentAt    DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("announcements")
}

/// Sign-in attempts, successful and failed. Failures are recorded without a
/// userId when the address does not exist, which is what makes credential
/// stuffing visible.
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  /// BAD_PASSWORD | UNVERIFIED | SUSPENDED | NO_ACCOUNT
  failReason String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
  @@map("login_history")
}

/// Unhandled server errors surfaced to the admin, so a production fault is
/// visible without shell access to the container logs.
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  /// Route or job that raised it.
  source    String?
  method    String?
  path      String?
  userId    String?
  /// Cleared once an admin has triaged it.
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([resolvedAt, createdAt])
  @@map("error_logs")
}

